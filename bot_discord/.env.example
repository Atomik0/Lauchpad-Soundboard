# Configuracion del Bot de Discord para Soundboard
# Copia este archivo a .env y completa con tu propio token de Discord Developer Portal

# Token del bot creado en https://discord.com/developers/applications
DISCORD_TOKEN=TU_DISCORD_BOT_TOKEN_AQUI

# Clave secreta que deben ingresar las aplicaciones de escritorio para conectarse
SECRET_KEY=launchpad2026

# Puerto del servidor WebSocket
PORT=3002

# Opciones adicionales
BOT_NAME=Soundboard Bot
PREFIX=/
LOCALE=es
